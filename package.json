{
  "name": "arconline-ext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run && node --test test/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "ci:build": "pnpm typecheck && pnpm test && pnpm build",
    "ci:deploy": "node scripts/deploy.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:browser:scores": "node scripts/smoke-song-search.mjs",
    "deploy:production": "node scripts/deploy.mjs --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^6.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "type": "module",
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "管理面板登录口令，请设置为足够长的随机字符串。"
      },
      "USERNAME": {
        "description": "你的 Arcaea / Lowiro 账号邮箱。"
      },
      "PASSWD": {
        "description": "你的 Arcaea / Lowiro 账号密码。"
      },
      "DB": {
        "description": "保存快照、PTT 历史、会话及任务的 D1 数据库。"
      },
      "ARCHIVE": {
        "description": "保存曲绘、角色图片和归档的私有 R2 桶，无需公开域名。"
      },
      "JOBS": {
        "description": "后台同步任务队列。"
      },
      "FAILED_JOBS": {
        "description": "重试次数耗尽后的死信队列。"
      }
    }
  }
}
