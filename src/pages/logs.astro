---
import { env } from "cloudflare:workers";
import type { Env } from "../lib/environment";
import Layout from "../layouts/Layout.astro";
import { LogsShell } from "../components/logs-shell";
import { getLogsPayload } from "../lib/logs";
const data = await getLogsPayload(env as Env);
---
<Layout title="日志 · Arcaea B50 Studio"><LogsShell initialData={data} client:load /></Layout>
