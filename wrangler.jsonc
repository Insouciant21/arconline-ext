{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arconline-ext",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SCHEDULE_TIMEZONE": "Asia/Shanghai",
    "DAILY_SYNC_ENABLED": "false",
    "MUTATIONS_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arconline-ext",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "arcaea-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "arcaea-jobs"
      },
      {
        "binding": "FAILED_JOBS",
        "queue": "arcaea-jobs-failed"
      }
    ],
    "consumers": [
      {
        "queue": "arcaea-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "arcaea-jobs-failed"
      }
    ]
  },
  "triggers": {
    "crons": [
      "59 15 * * *",
      "*/5 * * * *"
    ]
  }
}
