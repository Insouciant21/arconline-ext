# Arcaea / Lowiro credentials. The server is the only place that reads these.
USERNAME=your-account-email
PASSWD=your-password

# Cloudflare R2 S3-compatible API.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=arcaea-assets
# Public bucket custom domain or r2.dev URL. Leave empty to serve through /api/media.
R2_PUBLIC_URL=https://assets.example.com

# Auth.js session signing secret. Generate a long random value for production.
AUTH_SECRET=replace-with-a-long-random-secret
# Public origin used by Auth.js when constructing redirects.
AUTH_URL=http://localhost:3000
# Login access credential. It is checked only on the server by Auth.js.
ADMIN_TOKEN=replace-with-a-long-random-token

# Optional overrides.
DATA_DIR=./data
SCHEDULE_TIMEZONE=Asia/Shanghai
ARCAEA_USER_AGENT=Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36
