# Optional CLI credentials for importing old R2 backups and duplicate cleanup.
# These S3 keys are NOT uploaded to the Worker; it uses the ARCHIVE binding.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=arcaea-assets

# Optional alternative to `pnpm exec wrangler login` for deployment/migration CLI.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
