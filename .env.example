# CLI authentication normally uses `pnpm exec wrangler login`.
# Both the Worker and maintenance scripts use the native ARCHIVE R2 binding.
# The bucket and account are read from the selected config; no S3 keys are needed.
# ARCAEA_CONFIG=wrangler.production.jsonc
# Optional alternative for automation (D1/R2/Workers permissions required):
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
